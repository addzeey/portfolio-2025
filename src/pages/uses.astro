---
import { getEntryBySlug } from "astro:content";
import Layout from "../layouts/Layout.astro";

const uses = await getEntryBySlug("sections", "uses");
const Content = uses ? (await uses.render()).Content : undefined;
---

<Layout title="Uses | Adam Ashdown" description={uses?.data.description}>
	<section class="uses-page page-section">
		<div class="container">
			<p class="eyebrow">Workspace / tools</p>
			<h1>{uses?.data.title ?? "Uses"}</h1>
			{uses ? (
				<>
					<p class="uses-intro">{uses.data.description}</p>
					<article class="uses-body brutal-panel">{Content && <Content />}</article>
				</>
			) : (
				<div class="uses-body brutal-panel"><h2>Uses page not found</h2></div>
			)}
		</div>
	</section>
</Layout>

<style>
	.uses-page h1 { margin: 0; font-size: clamp(3.5rem, 8vw, 6rem); font-weight: 400; line-height: 0.9; text-transform: uppercase; }
	.uses-intro { max-width: 62ch; margin: 1.25rem 0 2rem; color: var(--colour-text-soft); }
	.uses-body { max-width: 900px; padding: clamp(1.25rem, 4vw, 2.5rem); border-color: var(--colour-border); box-shadow: var(--shadow-md); }
	.uses-body :global(h2) { margin: 2.2rem 0 0.8rem; color: var(--colour-pink-bright); font-size: 1.8rem; font-weight: 400; text-transform: uppercase; }
	.uses-body :global(h2:first-child) { margin-top: 0; }
	.uses-body :global(ul) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; padding: 0; list-style: none; }
	.uses-body :global(li) { padding: 0.85rem; border: 1px solid var(--colour-border-muted); background: var(--colour-surface-inset); color: var(--colour-text-soft); }
	.uses-body :global(strong) { color: var(--colour-text); }
	@media (max-width: 700px) { .uses-body :global(ul) { grid-template-columns: 1fr; } }
</style>
