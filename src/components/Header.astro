---
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const isHome = path === "/";
const links = [
	{ label: "About", href: "/#about" },
	{ label: "Capabilities", href: "/#capabilities" },
	{ label: "Projects", href: "/projects" },
	{ label: "Contact", href: "/#contact" },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Adam Ashdown, home">
			<Logo />
			<span>Adam Ashdown</span>
		</a>
		<button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">
			<span class="menu-label">Menu</span>
			<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
		</button>
		<nav id="site-navigation" class="site-navigation" aria-label="Primary navigation">
			{links.map(({ label, href }) => (
				<a href={href} aria-current={!isHome && label === "Projects" && path.startsWith("/projects/") ? "page" : undefined}>{label}</a>
			))}
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>(".menu-button");
	const navigation = document.querySelector<HTMLElement>(".site-navigation");
	const closeMenu = () => {
		button?.setAttribute("aria-expanded", "false");
		navigation?.classList.remove("is-open");
		document.body.classList.remove("menu-open");
	};
	button?.addEventListener("click", () => {
		const isOpen = button.getAttribute("aria-expanded") === "true";
		button.setAttribute("aria-expanded", String(!isOpen));
		navigation?.classList.toggle("is-open", !isOpen);
		document.body.classList.toggle("menu-open", !isOpen);
	});
	navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
			closeMenu();
			button.focus();
		}
		if (event.key === "Tab" && button?.getAttribute("aria-expanded") === "true" && navigation) {
			const links = Array.from(navigation.querySelectorAll<HTMLAnchorElement>("a"));
			const focusable = [button, ...links];
			const first = focusable[0];
			const last = focusable.at(-1);
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last?.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first?.focus();
			}
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		border-bottom: 1px solid var(--colour-border-muted);
		background: var(--colour-bg);
	}
	.header-inner { display: flex; min-height: 68px; align-items: center; justify-content: space-between; gap: 1.5rem; }
	.brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--colour-text); font-family: var(--font-display); font-size: 1.4rem; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
	.brand:hover { color: var(--colour-pink-bright); }
	.brand :global(svg) { width: 24px; height: 32px; flex: 0 0 auto; }
	.site-navigation { display: flex; align-items: center; gap: 0.2rem; }
	.site-navigation a { display: inline-flex; min-height: 44px; align-items: center; padding: 0.45rem 0.8rem; font-family: var(--font-display); font-size: 1.08rem; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
	.site-navigation a:hover { color: var(--colour-pink-bright); text-decoration: underline; text-underline-offset: 5px; }
	.site-navigation a[aria-current="page"] { background: var(--colour-pink); color: #fff; text-decoration: none; }
	.menu-button { display: none; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; gap: 0.45rem; border: 1px solid var(--colour-border); border-radius: 0; background: var(--colour-surface); color: var(--colour-text); font-family: var(--font-display); font-size: 1rem; text-transform: uppercase; }
	.menu-button svg { fill: none; stroke: currentColor; stroke-width: 2; }
	@media (max-width: 767px) {
		:global(body.menu-open) { overflow: hidden; }
		.menu-button { display: inline-flex; }
		.menu-button[aria-expanded="true"] { border-color: var(--colour-pink-bright); background: var(--colour-pink); }
		.site-navigation {
			position: fixed;
			top: 69px;
			right: 0;
			bottom: 0;
			left: 0;
			display: grid;
			height: calc(100dvh - 69px);
			align-content: center;
			gap: 0;
			padding: clamp(1.25rem, 6vw, 2rem);
			transform: translateY(-105%);
			border-bottom: 5px solid var(--colour-purple);
			background: var(--colour-bg);
			opacity: 0;
			visibility: hidden;
			transition: transform var(--duration-normal) var(--ease-mechanical), opacity var(--duration-fast) linear, visibility 0s var(--duration-normal);
		}
		.site-navigation::before { margin-bottom: 1rem; color: var(--colour-pink-bright); content: "NAVIGATION / 04"; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; }
		.site-navigation.is-open { transform: translateY(0); opacity: 1; visibility: visible; transition-delay: 0s; }
		.site-navigation a { min-height: clamp(64px, 15dvh, 92px); justify-content: space-between; padding: 0.7rem 0.25rem; border-top: 1px solid var(--colour-border-muted); font-size: clamp(2rem, 10vw, 3.5rem); line-height: 1; }
		.site-navigation a::after { color: var(--colour-pink-bright); content: "→"; font-size: 0.55em; }
		.site-navigation a:last-child { border-bottom: 1px solid var(--colour-border-muted); }
		.site-navigation a:hover { background: var(--colour-surface-raised); color: var(--colour-text); text-decoration: none; }
	}
</style>
