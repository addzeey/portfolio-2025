---
import ProjectCard from "./projects/ProjectCard.astro";
import { getHomepageProjects } from "../lib/projects";

const projects = await getHomepageProjects();

const capabilities = [
    {
        icon: "</>",
        title: "Product & Frontend",
        description:
            "Interfaces built with close attention to layout, interaction and readability.",
        technologies: "React · Vue · TypeScript · Astro",
    },
    {
        icon: "DB",
        title: "Backend & Systems",
        description:
            "APIs, service integrations and data pipelines for web applications.",
        technologies: ".NET · Go · Node.js · SQL",
    },
    {
        icon: "CI",
        title: "DevOps & Infrastructure",
        description:
            "CI/CD and cloud infrastructure for deploying and operating web applications.",
        technologies: "Cloudflare · Azure · Docker · CI/CD",
    },
    {
        icon: "{}",
        title: "Tools & Automation",
        description:
            "Automation for creator workflows, media processing and development tasks.",
        technologies: "APIs · Webhooks · FFmpeg · Automation",
    },
];
---

<section id="about" class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">Full-stack developer</p>
            <h1>I BUILD<br /><span>DIGITAL</span><br /><span>SOLUTIONS</span><br />THAT WORK.</h1>
            <p class="hero-description">
                Full-stack developer working across interfaces, backend services
                and cloud infrastructure, with a focus on streaming and community platforms.
            </p>
            <div class="hero-actions">
                <a class="button" href="#projects"
                    >View my work <span aria-hidden="true">→</span></a
                >
                <a class="button button--secondary" href="#contact"
                    >Get in touch</a
                >
            </div>
        </div>
        <aside class="status-card brutal-panel" aria-label="Development focus">
            <div>
                <span>Work</span><p>Streaming tools, community sites and backend services.</p>
            </div>
            <div>
                <span>Specialisms</span><ul>
                    <li>Platform integrations</li><li>Media workflows</li><li>Full-stack delivery</li>
                </ul>
            </div>
            <div>
                <span>Approach</span><p>I work across the interface and the systems behind it.</p>
            </div>
        </aside>
    </div>
</section>

<section id="projects" class="page-section projects-section">
    <div class="container">
        <div class="section-heading-row">
            <h2 class="section-heading">Selected work</h2>
            <a href="/projects">View all projects <span aria-hidden="true">→</span></a>
        </div>
        <div class="projects-grid">
            {
                projects.map((project, index) => (
                    <ProjectCard
                        project={project}
                        number={index + 1}
                        layout={index === 0 ? "featured" : index === 1 ? "secondary" : "standard"}
                    />
                ))
            }
        </div>
    </div>
</section>

<section id="capabilities" class="page-section capabilities-section">
    <div class="container">
        <h2 class="section-heading">What I do</h2>
        <div class="capabilities-grid">
            {
                capabilities.map((capability) => (
                    <article class="capability-card brutal-panel">
                        <span class="capability-icon" aria-hidden="true">
                            {capability.icon}
                        </span>
                        <h3>{capability.title}</h3>
                        <p>{capability.description}</p>
                        <small>{capability.technologies}</small>
                    </article>
                ))
            }
            <article class="capability-card integration-card brutal-panel">
                <span class="capability-icon" aria-hidden="true">↔</span>
                <div>
                    <h3>Platform & API Integrations</h3>
                    <small
                        >Twitch API · Extensions · EventSub · OAuth · Webhooks ·
                        Media pipelines</small
                    >
                </div>
                <p>
                    I connect Twitch and other APIs to authentication, events,
                    webhooks and media-processing workflows.
                </p>
            </article>
        </div>
    </div>
</section>

<section id="contact" class="contact-section">
    <div class="container">
        <div class="contact-banner">
            <h2>HAVE A PROJECT<br />IN MIND?</h2>
            <p>Tell me what you’re building and where you need help.</p>
            <a
                class="button button--secondary"
                href="mailto:info@aashdown.co.uk"
                >Let’s talk <span aria-hidden="true">→</span></a
            >
        </div>
    </div>
</section>

<style>
    .hero {
        padding: clamp(3.5rem, 7vw, 5rem) 0 clamp(4rem, 7vw, 5.5rem);
        border-bottom: 1px solid var(--colour-border-muted);
    }
    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(280px, 4fr);
        align-items: center;
        gap: clamp(2.5rem, 7vw, 6.5rem);
    }
    .hero h1 {
        margin: 0;
        font-size: clamp(4rem, 8vw, 7.3rem);
        font-weight: 400;
        letter-spacing: -0.025em;
        line-height: 0.75;
        text-transform: uppercase;
        text-wrap: balance;
    }
    .hero h1 span {
        color: var(--colour-pink-bright);
    }
    .hero-description {
        max-width: 58ch;
        margin: 1.9rem 0;
        color: var(--colour-text-soft);
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .status-card {
        padding: clamp(1.25rem, 3vw, 1.8rem);
        border-color: var(--colour-border);
        box-shadow: var(--shadow-lg);
    }
    .status-card > div + div {
        margin-top: 1.25rem;
    }
    .status-card span {
        color: var(--colour-pink-bright);
        font-family: var(--font-display);
        font-size: 1.12rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .status-card p {
        margin: 0.25rem 0 0;
        color: var(--colour-text-soft);
        font-size: 0.95rem;
        line-height: 1.55;
    }
    .status-card ul {
        margin: 0.35rem 0 0;
        padding-left: 1.2rem;
        color: var(--colour-text-soft);
        font-size: 0.95rem;
    }
    .projects-section {
        background: var(--colour-bg-alt);
    }
    .section-heading-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 1rem;
    }
    .section-heading-row > a {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 0.5rem;
        color: var(--colour-text-soft);
        font-family: var(--font-display);
        font-size: 1.05rem;
        text-decoration: none;
        text-transform: uppercase;
    }
    .section-heading-row > a:hover {
        color: var(--colour-pink-bright);
        text-decoration: underline;
        text-underline-offset: 5px;
    }
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
    }
    .capabilities-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--grid-gap);
    }
    .capability-card {
        padding: 1.2rem;
    }
    .capability-icon {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        color: var(--colour-pink-bright);
        font-family: var(--font-mono);
        font-size: 1.25rem;
        font-weight: 600;
    }
    .capability-card h3 {
        margin: 0.8rem 0 0.55rem;
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1.1;
        text-transform: uppercase;
    }
    .capability-card p {
        color: var(--colour-text-soft);
        font-size: 0.94rem;
        line-height: 1.55;
    }
    .capability-card small {
        color: var(--colour-text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        line-height: 1.5;
    }
    .integration-card {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 48px minmax(240px, 0.8fr) minmax(320px, 1.2fr);
        align-items: center;
        gap: 1.25rem;
        min-height: 118px;
        padding: 1rem 1.2rem;
        border-color: var(--colour-border-muted);
        border-left: 5px solid var(--colour-pink-bright);
        background: var(--colour-surface);
    }
    .integration-card .capability-icon {
        width: 40px;
        height: 40px;
        background: var(--colour-pink);
        color: #fff;
    }
    .integration-kicker {
        display: block;
        margin-bottom: 0.2rem;
        color: var(--colour-pink-bright);
        font-family: var(--font-mono);
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .integration-card h3 {
        margin: 0 0 0.3rem;
        color: #fff;
        font-size: 1.4rem;
    }
    .integration-card small {
        color: var(--colour-text-soft);
    }
    .integration-card p {
        margin: 0;
        color: #fff;
    }
    .contact-section {
        padding: 1rem 0 var(--section-space);
    }
    .contact-banner {
        display: grid;
        grid-template-columns: 1.2fr 1fr auto;
        align-items: center;
        gap: 2rem;
        padding: clamp(1.4rem, 3vw, 2rem);
        border: 2px solid var(--colour-pink-bright);
        background: var(--colour-pink);
        box-shadow: var(--shadow-lg);
    }
    .contact-banner h2 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.1rem);
        font-weight: 400;
        line-height: 0.9;
    }
    .contact-banner p {
        max-width: 34ch;
        margin: 0;
    }
    .contact-banner .button {
        white-space: nowrap;
    }
    @media (max-width: 900px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }
        .status-card {
            max-width: 560px;
        }
        .capabilities-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .integration-card {
            grid-template-columns: 44px 1fr;
        }
        .integration-card > p {
            grid-column: 2;
        }
        .contact-banner {
            grid-template-columns: 1fr 1fr;
        }
        .contact-banner .button {
            grid-column: 2;
        }
    }
    @media (max-width: 767px) {
        .hero h1 {
            font-size: clamp(3.6rem, 18vw, 5.25rem);
        }
        .projects-grid {
            grid-template-columns: 1fr;
        }
        .section-heading-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .section-heading-row .section-heading {
            margin-bottom: 0.5rem;
        }
        .section-heading-row > a {
            margin-bottom: 1.25rem;
        }
        .capabilities-grid {
            grid-template-columns: 1fr;
        }
        .integration-card {
            grid-template-columns: 38px 1fr;
            gap: 0.8rem;
        }
        .integration-card > p {
            grid-column: 1 / -1;
        }
        .contact-banner {
            grid-template-columns: 1fr;
        }
        .contact-banner .button {
            grid-column: auto;
            justify-self: start;
        }
    }
    @media (max-width: 430px) {
        .hero-actions {
            display: grid;
        }
        .hero-actions .button {
            width: 100%;
        }
    }
</style>
